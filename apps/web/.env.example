# Copy to .env.local. Never commit real values.
DATABASE_URL=postgres://zirr:zirr@localhost:5432/zirr_dev
# Demo mode: mock connectors, a demo owner, sample data and a test product. Never set it with live accounts.
DEMO_MODE=true
# Long random strings. The owner app sends OWNER_API_TOKEN; each provider signs its webhooks with its secret.
# On a hosted install, npm run db:deploy makes all three in the database (ops.secrets), so they can stay unset there.
OWNER_API_TOKEN=change-me
OWNER_USER_ID=00000000-0000-4000-8000-000000000001
PAYMENTS_WEBHOOK_SECRET=change-me
SUPPLIER_WEBHOOK_SECRET=change-me
# One token per department bot, as JSON: {"<token>": "sales", "<token>": "support"}
AGENT_TOKENS={}
# Optional: accept signed-in Supabase staff as well as the owner token.
SUPABASE_JWT_SECRET=
# The address of the owner app when it runs in a browser, so that it may call this API. Comma-separated.
OWNER_APP_ORIGIN=
